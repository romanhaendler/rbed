<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The Scenarios of the documentation site, compiled with rbed to one JavaScript module by
       TeaVM (target/js/rbed.js). Not released; see docs/adr/0005-site-runs-rbed-through-teavm.md. -->
  <groupId>io.github.romanhaendler</groupId>
  <artifactId>rbed-site-scenarios</artifactId>
  <version>0</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- rbed.version has no default: site/package.json passes the version of ../../pom.xml
         (node version.mjs), so the site uses the rbed of the same commit (installed with mvn
         install from the repository root). By hand: -Drbed.version=$(node ../version.mjs) -->
    <teavm.version>0.16.0</teavm.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.romanhaendler</groupId>
      <artifactId>rbed</artifactId>
      <version>${rbed.version}</version>
    </dependency>
    <!-- @JSExport; compile time only, the JVM ignores the missing annotation -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- TeaVM's JDK emulation, needed by the compiler -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <targetType>JAVASCRIPT</targetType>
              <mainClass>io.github.romanhaendler.rbed.site.Bridge</mainClass>
              <jsModuleType>ES2015</jsModuleType>
              <targetDirectory>${project.build.directory}/js</targetDirectory>
              <targetFileName>rbed.js</targetFileName>
              <minifying>true</minifying>
              <optimizationLevel>ADVANCED</optimizationLevel>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
